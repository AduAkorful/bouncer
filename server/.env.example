# Server environment. Values are set in Render, never committed. Secrets are marked secret there.
NEAR_RPC_URL=
NEAR_NETWORK_ID=
VAULT_CONTRACT_ID=
# The default vault for /crack and /guard callers that do not name one.
RELAY_ACCOUNT_ID=
# Full access. Used only to create passkey accounts and relay the claims players sign.
RELAY_PRIVATE_KEY=
# A function-call key on the relay account: receiver VAULT_CONTRACT_ID, method submit_verdict only.
# The server reads its permission from the chain and refuses verdicts unless it is exactly that.
RELAY_VERDICT_KEY=
# The gas allowance, in NEAR, the scoped keys were created with. Used for the low-allowance warning. Defaults to 1.
KEY_ALLOWANCE_NEAR=
OUTLAYER_CALL_URL=
OUTLAYER_PAYMENT_KEY=
OUTLAYER_VERSION_KEY=
OUTLAYER_MAX_EXECUTION_SECONDS=
OUTLAYER_MAX_MEMORY_MB=
# Comma separated origins allowed to call this server, for example https://bouncer-delta.vercel.app
SITE_ORIGIN=
SPONSOR_DAILY_CALLS=
# Optional. Both or neither. The key must be a function-call key on VAULT_CONTRACT_ID for close_round and commit_round only.
KEEPER_ACCOUNT_ID=
KEEPER_PRIVATE_KEY=
PORT=

# Bills one vault takes in one round, across every player. Defaults to 5000.
VAULT_ROUND_BILLS=

# Optional. All five, or none. SurrealDB Cloud keeps the player record. A file on this service does not.
SURREAL_URL=
SURREAL_USER=
SURREAL_PASS=
SURREAL_NS=
SURREAL_DB=

# Optional server-only credential for sponsor draft generation.
NEAR_AI_KEY=

