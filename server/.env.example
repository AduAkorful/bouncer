# Server environment. Values are set in Render, never committed. Secrets are marked secret there.
NEAR_RPC_URL=
NEAR_NETWORK_ID=
VAULT_CONTRACT_ID=
# The default vault for /crack and /guard callers that do not name one.
VAULT_ID=
RELAY_ACCOUNT_ID=
RELAY_PRIVATE_KEY=
OUTLAYER_CALL_URL=
OUTLAYER_PAYMENT_KEY=
OUTLAYER_VERSION_KEY=
OUTLAYER_MAX_EXECUTION_SECONDS=
OUTLAYER_MAX_MEMORY_MB=
AUTH_CONTRACT_ID=
# Comma separated origins allowed to call this server, for example https://bouncer-delta.vercel.app
SITE_ORIGIN=
SPONSOR_DAILY_CALLS=
# Optional. Both or neither.
KEEPER_ACCOUNT_ID=
KEEPER_PRIVATE_KEY=
PORT=

# Bills one vault takes in one round, across every player. Defaults to 5000.
VAULT_ROUND_BILLS=

# Optional. All five, or none. SurrealDB Cloud keeps the player record. A file on this service does not.
SURREAL_URL=
SURREAL_USER=
SURREAL_PASS=
SURREAL_NS=
SURREAL_DB=

# Optional server-only credential for sponsor draft generation.
NEAR_AI_KEY=

