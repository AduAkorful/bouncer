# Names only. Values stay empty here. The app does not fill them in.
# The keys live on the server in ../server, not in this project.

NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_KEEPER_ACCOUNT_ID=

NEXT_PUBLIC_RPC_URL=
# Optional. A second https RPC endpoint for the last try of a page read.
NEXT_PUBLIC_RPC_FALLBACK_URL=
# Optional. An https node that keeps old blocks, for checking wins older than a few days on /wins.
NEXT_PUBLIC_ARCHIVAL_RPC_URL=
# Optional. OutLayer's API (https). The claim page reads a guard call's attestation from it directly.
NEXT_PUBLIC_OUTLAYER_API_URL=
# Optional. The guard wasm SHA-256 this build pins (64 hex). Must equal the server's OUTLAYER_VERSION_KEY.
NEXT_PUBLIC_GUARD_VERSION=
NEXT_PUBLIC_VAULT_CONTRACT_ID=
NEXT_PUBLIC_CURRENCY=
NEXT_PUBLIC_CURRENCY_DECIMALS=
NEXT_PUBLIC_NETWORK_TAG=
NEXT_PUBLIC_NETWORK_ID=
NEXT_PUBLIC_STORAGE_NAME=
NEXT_PUBLIC_MESSAGE_BUDGET=
NEXT_PUBLIC_VENUE=
